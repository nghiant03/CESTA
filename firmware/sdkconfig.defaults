# Rust often requires a bit of esp-idf configuration to use certain features.
# ESP-IDF configuration options:
#   https://docs.espressif.com/projects/esp-idf/en/latest/esp32s3/api-reference/kconfig.html

# Enable WiFi
CONFIG_ESP_WIFI_ENABLED=y

# Enable SNTP for time sync
CONFIG_LWIP_SNTP_MAX_SERVERS=1

# Increase main task stack size for Rust
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Enable MQTT
CONFIG_MQTT_PROTOCOL_311=y

# Enable ESP32-S3 octal PSRAM for the TensorFlow Lite tensor arena and the
# large MQTT exchange and window buffers
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# Accommodate the embedded model and firmware runtime
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Use the USB-UART bridge for boot and panic logs across ESP32 resets.
# Keep native USB Serial/JTAG as an additional non-blocking log output.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
